{
  "info": {
    "name": "Stockly API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Execute na ordem. A sessão PHP é mantida pelo cookie jar do Postman. Ajuste baseUrl conforme seu ambiente."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost/stockly/public"
    },
    {
      "key": "csrf",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Obter token CSRF (inicia a sessão)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api.php?r=auth/csrf",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api.php"
          ],
          "query": [
            {
              "key": "r",
              "value": "auth/csrf"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "pm.collectionVariables.set('csrf', j.data.csrf_token);",
              "pm.test('CSRF obtido', () => pm.expect(j.success).to.be.true);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Login (válido)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-Token",
            "value": "{{csrf}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api.php?r=auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api.php"
          ],
          "query": [
            {
              "key": "r",
              "value": "auth/login"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@stockly.com\",\n  \"senha\": \"admin123\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.data) pm.collectionVariables.set('csrf', j.data.csrf_token);",
              "pm.test('Login OK', () => pm.expect(j.success).to.be.true);"
            ]
          }
        }
      ]
    },
